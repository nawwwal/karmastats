      "destination": "/tools/:slug/index.html"
    },
    {
      "source": "/references",
      "destination": "/references/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/test",
      "destination": "/test/index.html"
    }
  ]
}
